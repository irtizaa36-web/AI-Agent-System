{
  "name": "ai-agent-orchestrator",
  "version": "0.1.0",
  "private": true,
  "description": "Model-agnostic, CLI-first AI agent orchestrator",
  "main": "dist/cli/index.js",
  "bin": {
    "orchestrator": "dist/cli/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test \"dist/**/*.test.js\"",
    "cli": "npm run build --silent && node dist/cli/index.js",
    "cli:env": "npm run build --silent && node --env-file=.env dist/cli/index.js"
  },
  "dependencies": {
    "@inkbox/sdk": "^0.6.6",
    "playwright": "^1.48.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^5.9.3"
  }
}
